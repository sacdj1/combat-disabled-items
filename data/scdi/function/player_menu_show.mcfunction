# "My Settings" - self-service menu, any player, no op needed - unlike
# /menu (admin-only), this only ever reads/writes the triggering player's
# OWN scores. reached via /trigger ScdiPlayerMenu.
tellraw @s ["",{"text":"===== ","color":"dark_gray"},{"text":"My Settings","color":"aqua","bold":true},{"text":" =====","color":"dark_gray"}]

execute if score @s scdi_armor_warning_pref matches 1.. run tellraw @s [{"text":"Warn me when my armor is disabled: ","color":"light_purple"},{"text":"YES","color":"green","bold":true}]
