tellraw @s [{"text":"Flash particles on disguised armor: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_flash_on"},"hover_event":{"action":"show_text","value":"Currently-disguised armor gets dust particles flashing around it, mostly color A with occasional color B (default red/yellow, see the two colors below) - a clear signal on the armor itself, not just your own UI. Particles only, doesn't touch the armor's own data."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_flash_off"},"hover_event":{"action":"show_text","value":"No particles."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"disguise_armor_flash","storage":"scdi:config","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"Flash interval (ticks per phase): ","color":"light_purple"},{"nbt":"disguise_armor_flash_interval","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config disguise_armor_flash_interval set value 4"},"hover_event":{"action":"show_text","value":"How long (20 ticks = 1 second) each particle color phase lasts, if flashing above is on. Cycle is color A/color B/color A/color A, so a full cycle takes 4x this value. Default 4 = 0.2s per phase, 0.8s per full cycle."}}]
tellraw @s [{"text":"Flash color A (3x as common): ","color":"light_purple"},{"nbt":"disguise_armor_flash_color_a","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config disguise_armor_flash_color_a set value 16711680"},"hover_event":{"action":"show_text","value":"Packed 24-bit RGB int (same format minecraft:dyed_color/leather dye uses) - default 16711680 = pure red. Used by both the particle flash and, if 'Also recolor the armor itself' below is on, the actual armor repaint. A color picker's hex value converts directly: #RRGGBB hex is the same number in base 16, e.g. #FF0000 = 16711680."}}]
tellraw @s [{"text":"Flash color B (1x): ","color":"light_purple"},{"nbt":"disguise_armor_flash_color_b","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config disguise_armor_flash_color_b set value 16776960"},"hover_event":{"action":"show_text","value":"Same format as color A above - default 16776960 = pure yellow."}}]

tellraw @s [{"text":"Also recolor the armor itself on flash: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_recolor_on"},"hover_event":{"action":"show_text","value":"The worn armor's own tint also flips between color A/color B (see above) on every flash phase, on top of the particles. Every attempt to make this silent failed (Minecraft's equip_sound has no volume control and no real sound is silent by nature) - this WILL play a sound every phase change. Off by default for that reason - see the sound setting below to at least pick something less jarring."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_recolor_off"},"hover_event":{"action":"show_text","value":"Particles only, silent (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"disguise_armor_recolor","storage":"scdi:config","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"Armor equip sound: ","color":"light_purple"},{"nbt":"disguise_armor_equip_sound","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config disguise_armor_equip_sound set value \"minecraft:block.candle.extinguish\""},"hover_event":{"action":"show_text","value":"Which sound plays on the disguised armor's equip events - always once on the initial swap (normal/expected, same as any equip), and again on every repaint if 'Also recolor the armor itself on flash' above is on. Defaults to a soft candle-extinguish puff, about as quiet as a vanilla sound event gets, instead of the default harsh armor clink. Any vanilla sound event id - try /playsound minecraft:block.amethyst_block.chime master @s for a brighter alternative."}}]

tellraw @s [{"text":"New players default to warning when armor is disabled: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_warning_on"},"hover_event":{"action":"show_text","value":"A newly-seen player starts with the one-time-per-encounter 'your armor has been disabled' chat warning turned on (default). Per-player from here on - each player can turn it (and its sound) on/off for themselves any time via /trigger ScdiPlayerMenu, this is only the starting point for someone never seen before."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_warning_off"},"hover_event":{"action":"show_text","value":"New players start with the warning off."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"disguise_armor_warning","storage":"scdi:config","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"  ...and with a sound too: ","color":"gray"},{"text":"[ON]","color":"green","click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_warning_sound_on"},"hover_event":{"action":"show_text","value":"That warning also plays its own dedicated sound (see below), only to the warned player, by default for new players."}},{"text":"  "},{"text":"[OFF]","color":"red","click_event":{"action":"run_command","command":"/function scdi:menu/disguise_armor_warning_sound_off"},"hover_event":{"action":"show_text","value":"Message only by default (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"disguise_armor_warning_sound","storage":"scdi:config","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"  sound: ","color":"gray"},{"nbt":"disguise_armor_warning_sound_id","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config disguise_armor_warning_sound_id set value \"minecraft:block.note_block.bit\""},"hover_event":{"action":"show_text","value":"Which sound plays for the armor-disabled warning above, if its sound preference is on. Uses combat_pitch/combat_volume, just its own sound event id, separate from combat_sound. Always played only to the one warned player (playsound ... master @s), never broadcast. Any vanilla sound event id."}}]
tellraw @s [{"text":"New players default to warning when an item is disabled in inventory: ","color":"light_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_inventory_warning_on"},"hover_event":{"action":"show_text","value":"A newly-seen player starts with the one-time-per-encounter 'an item has been disabled in your inventory' chat warning turned on - covers firework rockets/wind charges/elytra-in-inventory/mainhand-offhand custom items. Per-player from here on via /trigger ScdiPlayerMenu, this is only the starting point for someone never seen before."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/disguise_inventory_warning_off"},"hover_event":{"action":"show_text","value":"New players start with the warning off (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"disguise_inventory_warning","storage":"scdi:config","interpret":false,"color":"yellow"}]
