tellraw @s [{"text":"Announce one-shots: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/announce_one_shot_on"},"hover_event":{"action":"show_text","value":"Chat announces it when a player's FIRST hit of a fresh encounter (not already tagged) is also the killing blow (default). Hit-based only - never fires from proximity tagging. Can't name the attacker (not exposed by the hit-detection advancement)."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/announce_one_shot_off"},"hover_event":{"action":"show_text","value":"No announcement."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"announce_one_shot","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"One-shot ignores tagging: ","color":"light_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/one_shot_ignore_tag_on"},"hover_event":{"action":"show_text","value":"Every kill announces as a one-shot, even if the victim was already tagged/mid-fight - not just an instant kill from a clean, untagged start."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/one_shot_ignore_tag_off"},"hover_event":{"action":"show_text","value":"Only a fresh-encounter kill (victim wasn't already tagged going in) counts as a one-shot (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"one_shot_ignore_tag","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"Skip attacker tag on one-shot kill: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/no_tag_on_one_shot_kill_on"},"hover_event":{"action":"show_text","value":"Killing someone in the hit that first tags them skips tagging the attacker - the fight's already over, so hit-and-run prevention doesn't apply. Guessed via proximity (nearest player hit)."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/no_tag_on_one_shot_kill_off"},"hover_event":{"action":"show_text","value":"The attacker always gets tagged, even on a clean kill (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"no_tag_on_one_shot_kill","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"Skip victim tag on one-shot kill: ","color":"light_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/no_tag_victim_on_one_shot_on"},"hover_event":{"action":"show_text","value":"Getting one-shot skips tagging the victim (default) - no proximity guessing needed, they check their own health directly. Useful for repeated one-shot testing: without this, a victim who stays tagged through death (reset_on_death off) reads as 'already tagged' on their next instant kill, so announce_one_shot only fires every other time instead of every time."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/no_tag_victim_on_one_shot_off"},"hover_event":{"action":"show_text","value":"The victim always gets tagged, even on a clean kill."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"no_tag_victim_on_one_shot","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"One-shot cooldown tightening: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/one_shot_cooldown_enabled_on"},"hover_event":{"action":"show_text","value":"Also requires the victim to have been out of combat for one_shot_cooldown ticks - closes the 'get them low, wait out the tag, finish them off later' loophole."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/one_shot_cooldown_enabled_off"},"hover_event":{"action":"show_text","value":"Untagged going into the hit is enough on its own, same as always (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"one_shot_cooldown_enabled","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"One-shot cooldown (ticks): ","color":"light_purple"},{"nbt":"one_shot_cooldown","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config one_shot_cooldown set value 200"},"hover_event":{"action":"show_text","value":"How long (20 ticks = 1 second) out of combat the victim must have been for a kill to still count as a one-shot, if the tightening above is on."}}]

