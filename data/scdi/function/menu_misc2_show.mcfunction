tellraw @s [{"text":"Dummy max health (new dummies + invincible): ","color":"dark_purple"},{"nbt":"dummy_max_health","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config dummy_max_health set value 10000"},"hover_event":{"action":"show_text","value":"Health pool every newly spawned dummy gets, and the same pool an existing dummy gets boosted to when toggled invincible via [Manage nearest dummy] -> [Make invincible]. For a mortal dummy this is purely a safety margin against item loss (see 'Dummy simulated health' below for what actually decides when it dies) - for an invincible one, it's the real pool its repeating 'cheated death' segments draw from. Only affects dummies spawned/toggled AFTER you change this, not existing ones."}}]
tellraw @s [{"text":"Dummy simulated health (health): ","color":"light_purple"},{"nbt":"dummy_one_shot_damage","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config dummy_one_shot_damage set value 20"},"hover_event":{"action":"show_text","value":"A mortal dummy's REAL death gate - a simulated health pool capped at this value that drains with every hit and regenerates over time, exactly like a real player's. Default 20 (a normal player's own max health), so both a single one-shot-capable hit AND cumulative/sustained damage kill the dummy exactly like they would a real player. The large buffer pool elsewhere is just a safety margin against item loss, not what decides this."}}]

