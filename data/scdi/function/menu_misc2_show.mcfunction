tellraw @s [{"text":"DPS averaging window (ticks): ","color":"light_purple"},{"nbt":"dummy_dps_window","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config dummy_dps_window set value 20"},"hover_event":{"action":"show_text","value":"Minimum time (20 ticks = 1 second by default) the live DPS readout above a dummy's head averages damage over, even right after a fresh encounter's first hit - without this floor, an early hit gets divided by however few ticks have actually passed and shows a wildly inflated instantaneous rate. Raise for a smoother/slower number, lower (minimum 1) for a twitchier one that reacts to single hits almost immediately."}}]

