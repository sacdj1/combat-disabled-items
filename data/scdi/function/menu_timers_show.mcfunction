tellraw @s [{"text":"Passive restore: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/passive_restore_on"},"hover_event":{"action":"show_text","value":"Continuously re-check/restore nulled items every tick for anyone not in combat (default). Costs a little extra performance on busy servers."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/passive_restore_off"},"hover_event":{"action":"show_text","value":"Only restore exactly once, the instant combat ends. Cheaper, less tamper-resistant."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"passive_restore","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"Passive restore interval (ticks): ","color":"light_purple"},{"score":{"name":"$passive_restore_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $passive_restore_interval scdi_const 1"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) the passive restore safety net runs (only relevant if Passive restore is ON)."}}]

tellraw @s [{"text":"Proximity interval (ticks): ","color":"light_purple"},{"score":{"name":"$proximity_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $proximity_interval scdi_const 1"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) proximity tagging checks run (only relevant if Proximity tagging is ON)."}}]

tellraw @s [{"text":"Nullify interval (ticks): ","color":"dark_purple"},{"score":{"name":"$nullify_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $nullify_interval scdi_const 1"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) the core mainhand/offhand/armor disguise check runs for every tagged player/dummy - the actual thing this pack does, not a secondary safety net like the intervals above. Default 1 (every tick). Raising it means a tagged player's rocket/wind charge/worn elytra/custom item can stay REAL for up to that many extra ticks before getting disguised - a real gameplay tradeoff, not just a free performance win. Only raise it if you're actually seeing server lag with many simultaneously-tagged players."}}]

tellraw @s [{"text":"Combat-tick stopwatch interval (ticks): ","color":"dark_purple"},{"score":{"name":"$combat_tick_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $combat_tick_interval scdi_const 1"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) each tagged player/dummy's real-time combat-lock stopwatch gets QUERIED, for every currently-tagged entity - not the same as restarting it on a hit (retag_resets_timer), which always happens immediately regardless. 'stopwatch' is a third-party mod command, not vanilla - this pack can't inspect its per-call cost, but querying it 20x/second when the countdown it drives only visually changes once a second is more often than strictly needed. Raising this trades a choppier 'Tagged!' flash in the first second, and up to (interval-1) extra ticks before combat is detected as over, for fewer stopwatch queries per second. Default 1 (every tick). Try raising this if you suspect the stopwatch mod itself is contributing to lag."}}]

tellraw @s [{"text":"Dummy look-at-player interval (ticks): ","color":"light_purple"},{"score":{"name":"$dummy_look_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $dummy_look_interval scdi_const 2"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) each dummy's face-the-nearest-player rotation updates - cost scales with how many dummies exist at once. Default 2 (10/sec) is still smooth; raise it if you're spawning many dummies at once and seeing server lag."}}]
tellraw @s [{"text":"Dummy display-follow interval (ticks): ","color":"light_purple"},{"score":{"name":"$dummy_display_interval","objective":"scdi_const"},"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set $dummy_display_interval scdi_const 2"},"hover_event":{"action":"show_text","value":"How often (in ticks, 20=1s) each dummy's floating displays (health/DPS/tag/one-shot/cheated-death) re-track its position - cost scales with dummy count x display count. Default 2 (10/sec) is still smooth."}}]

tellraw @s [{"text":"Placement-revert radius: ","color":"light_purple"},{"nbt":"placement_revert_radius","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config placement_revert_radius set value 4"},"hover_event":{"action":"show_text","value":"How wide an area gets cleared if a tagged player places a block matching the disguise item. Only matters if disguise_item is placeable."}}]

