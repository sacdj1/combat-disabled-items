# shows status + actions for whichever test dummy is nearest to @s (within
# 10 blocks) - called from dummy_menu_trigger.mcfunction (public, gated by
# allow_dummy_trigger) and menu/manage_nearest_dummy.mcfunction (op-only
# shortcut in /menu -> Misc). @s stays the PLAYER throughout - reads the
# dummy's NBT via selectors rather than switching "as" to it, since tellraw
# has to reach the player, not the (non-player) dummy.
tellraw @s ["",{"text":"===== ","color":"dark_gray"},{"text":"Nearest Test Dummy","color":"red","bold":true},{"text":" =====","color":"dark_gray"}]
execute at @s as @e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1] at @s run function scdi:apply_compute_dummy_display_health
tellraw @s [{"text":"Health: ","color":"dark_purple"},{"nbt":"hp","storage":"scdi:tmp9","interpret":false,"color":"yellow"},{"text":"/","color":"light_purple"},{"nbt":"max","storage":"scdi:tmp9","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"Head: ","color":"dark_purple"},{"nbt":"equipment.head.id","entity":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","interpret":false,"color":"yellow"},{"text":"  Chest: ","color":"light_purple"},{"nbt":"equipment.chest.id","entity":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"Legs: ","color":"light_purple"},{"nbt":"equipment.legs.id","entity":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","interpret":false,"color":"yellow"},{"text":"  Feet: ","color":"light_purple"},{"nbt":"equipment.feet.id","entity":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","interpret":false,"color":"yellow"}]
tellraw @s [{"text":"Team: ","color":"light_purple"},{"score":{"name":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","objective":"scdi_team"},"color":"yellow"},{"text":" (0 = none - won't proximity-tag anyone on that team)","color":"dark_gray"}]
tellraw @s [{"text":"Damage dealt this encounter: ","color":"light_purple"},{"score":{"name":"@e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1]","objective":"scdi_dummy_total_dmg"},"color":"yellow"},{"text":" (live DPS shown on its floating health readout)","color":"dark_gray"}]
execute if entity @e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1,scores={scdi_dummy_invincible=1..}] run tellraw @s [{"text":"Invincible: ","color":"light_purple"},{"text":"YES","color":"green","bold":true}]
execute unless entity @e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1,scores={scdi_dummy_invincible=1..}] run tellraw @s [{"text":"Invincible: ","color":"light_purple"},{"text":"no","color":"red"}]
execute if entity @e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1,scores={scdi_dummy_pinned=1..}] run tellraw @s [{"text":"Pinned in place: ","color":"light_purple"},{"text":"YES","color":"green","bold":true}]
execute unless entity @e[type=minecraft:mannequin,tag=scdi_dummy,distance=..10,sort=nearest,limit=1,scores={scdi_dummy_pinned=1..}] run tellraw @s [{"text":"Pinned in place: ","color":"light_purple"},{"text":"no","color":"red"}]
tellraw @s [{"text":"[Heal to full]","color":"green","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 1"},"hover_event":{"action":"show_text","value":"Resets its health to full."}},{"text":"  "},{"text":"[Drop items]","color":"gold","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 3"},"hover_event":{"action":"show_text","value":"Drops everything it has equipped as real item entities on the ground, without killing it."}},{"text":"  "},{"text":"[Remove]","color":"red","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 4"},"hover_event":{"action":"show_text","value":"Drops its items, then kills this dummy."}}]
tellraw @s [{"text":"[Add to my team]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 5"},"hover_event":{"action":"show_text","value":"Puts this dummy on your scdi_team (assigning you one first if you don't have one yet) - it and your teammates stop proximity-tagging each other."}},{"text":"  "},{"text":"[Remove from team]","color":"gray","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 6"},"hover_event":{"action":"show_text","value":"Resets this dummy's team back to none."}}]
tellraw @s [{"text":"[Make immune to knockback]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 7"},"hover_event":{"action":"show_text","value":"This specific dummy stays exactly where it is, never getting shoved around by hits."}},{"text":"  "},{"text":"[Allow knockback]","color":"gray","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 8"},"hover_event":{"action":"show_text","value":"This specific dummy takes real knockback like any other entity. Per-dummy setting - see 'New dummies immune to knockback' in /menu -> Misc for the default new ones spawn with."}}]
tellraw @s [{"text":"[Pin in place]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 9"},"hover_event":{"action":"show_text","value":"Stronger than immune to knockback - gets teleported back to its exact current position every tick, immune to pistons, water/lava currents, or anything else that would move it, not just combat hits."}},{"text":"  "},{"text":"[Allow movement]","color":"gray","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 10"},"hover_event":{"action":"show_text","value":"Releases the pin - this dummy can be moved/pushed by anything again (default)."}}]
tellraw @s [{"text":"[Make invincible]","color":"aqua","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 11"},"hover_event":{"action":"show_text","value":"Gets a large health pool (dummy_max_health, see /menu -> Misc) and heals to full - never realistically reaches 0 from normal combat. Also heals back with a \"cheated death\" particle burst if a hit somehow still crosses the death threshold, as a backstop."}},{"text":"  "},{"text":"[Make mortal]","color":"gray","underlined":true,"click_event":{"action":"run_command","command":"/trigger ScdiDummyAction set 12"},"hover_event":{"action":"show_text","value":"Shrinks back down to a normal 20 health and heals to that - drops its items and dies normally on a lethal hit again, like a realistic target (default)."}}]
tellraw @s {"text":"(re-targets whichever dummy is nearest you at the moment you click)","color":"dark_gray","italic":true}
