tellraw @s [{"text":"Proximity tagging: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/proximity_tagging_on"},"hover_event":{"action":"show_text","value":"Items stay disabled continuously while another player is within proximity_distance blocks, even without a hit."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/proximity_tagging_off"},"hover_event":{"action":"show_text","value":"Only actual hits tag you (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"proximity_tagging","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"Proximity distance: ","color":"light_purple"},{"nbt":"proximity_distance","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config proximity_distance set value 6.0"},"hover_event":{"action":"show_text","value":"How close (in blocks) another player needs to be to FIRST trigger proximity tagging, if enabled above."}}]
tellraw @s [{"text":"Proximity retag distance: ","color":"light_purple"},{"nbt":"proximity_retag_distance","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config proximity_retag_distance set value 6.0"},"hover_event":{"action":"show_text","value":"How close another player needs to STAY to keep refreshing an already-active proximity tag - separate from the (tighter, usually) distance needed to trigger it in the first place. Same default as proximity distance, so raise this above it for an aggro-vs-leash feel where drifting slightly further away doesn't instantly drop the lock."}}]

tellraw @s [{"text":"Proximity attacker/victim by movement: ","color":"dark_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/proximity_role_by_movement_on"},"hover_event":{"action":"show_text","value":"Between two nearby players, whichever is moving MORE is treated as the attacker (gated by Tag attacker too), whichever is moving the same or less - including both standing still - is treated as the victim (gated by Tag victim). Only applies to plain nearby-player proximity tagging, not the team-aware nearby-non-teammate-count case."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/proximity_role_by_movement_off"},"hover_event":{"action":"show_text","value":"Both nearby players are proximity-tagged the same way regardless of movement (default) - Tag attacker/Tag victim don't apply to proximity at all."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"proximity_role_by_movement","storage":"scdi:config","interpret":false,"color":"yellow"}]

tellraw @s [{"text":"Team exemption (proximity only): ","color":"dark_purple"},{"text":"[Info]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set  scdi_team 1"},"hover_event":{"action":"show_text","value":"Assign players to the same non-zero scdi_team score and they'll never proximity-tag each other, unless 'Teammates proximity-tag each other' below is turned on. For hit-based exemption, use vanilla: /team modify <team> friendlyFire false"}}]

tellraw @s [{"text":"Request/confirm teaming up: ","color":"light_purple"},{"text":"[Info]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/trigger ScdiTeamRequest"},"hover_event":{"action":"show_text","value":"Any player can run /trigger ScdiTeamRequest to ask the nearest player (within 10 blocks) to team up - they get a clickable [Accept] that runs /trigger ScdiTeamConfirm. This sets scdi_team automatically for both, same effect as the manual scoreboard command above. /trigger ScdiTeamReset clears your own team back to none."}}]

tellraw @s [{"text":"Untaggable players (admin exemption): ","color":"light_purple"},{"text":"[Info]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/scoreboard players set  scdi_untaggable 1"},"hover_event":{"action":"show_text","value":"A player with this score set to 1+ can never be tagged into combat at all, through any path. Reset it (/scoreboard players reset <player> scdi_untaggable) to make them taggable again. Immediately releases them if they're already mid-combat."}}]

tellraw @s [{"text":"Ignore Creative mode players: ","color":"light_purple"},{"text":"[ON]","color":"green","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/ignore_creative_on"},"hover_event":{"action":"show_text","value":"Players in Creative mode are exempt from tagging entirely (victim or attacker) - mostly matters for the attacker side, since Creative already blocks most PvP damage to them as a victim."}},{"text":"  "},{"text":"[OFF]","color":"red","bold":true,"click_event":{"action":"run_command","command":"/function scdi:menu/ignore_creative_off"},"hover_event":{"action":"show_text","value":"No Creative-mode exemption (default)."}},{"text":"  currently: ","color":"dark_gray"},{"nbt":"ignore_creative","storage":"scdi:config","interpret":false,"color":"yellow"}]

