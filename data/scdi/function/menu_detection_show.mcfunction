tellraw @s [{"text":"Proximity retag distance: ","color":"white"},{"nbt":"proximity_retag_distance","storage":"scdi:config","interpret":false,"color":"yellow"},{"text":"  "},{"text":"[Edit]","color":"aqua","underlined":true,"click_event":{"action":"suggest_command","command":"/data modify storage scdi:config proximity_retag_distance set value 6.0"},"hover_event":{"action":"show_text","value":"How close another player needs to STAY to keep refreshing an already-active proximity tag - separate from the (tighter, usually) distance needed to trigger it in the first place. Same default as proximity distance, so raise this above it for an aggro-vs-leash feel where drifting slightly further away doesn't instantly drop the lock."}}]

